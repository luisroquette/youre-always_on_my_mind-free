# Copy the values you need into your shell profile or MCP client's environment.
# Do not commit a real .env file, databases, logs or credentials.

# A local executable implementing the bridge contract in docs/ADAPTERS.md.
# The default preserves compatibility with the Claude-memory bridge used by Codex.
# YOURE_ALWAYS_ON_MY_MIND_BRIDGE_PATH=/absolute/path/to/your/bridge

# Directory for feedback, alert configuration and bridge-owned local data.
# YOURE_ALWAYS_ON_MY_MIND_DATA_DIR=$HOME/.always-on-my-mind

# Override only when your bridge exposes a different SQLite source.
# YOURE_ALWAYS_ON_MY_MIND_DATABASE_PATH=$HOME/.always-on-my-mind/memory.db
# YOURE_ALWAYS_ON_MY_MIND_FEEDBACK_PATH=$HOME/.always-on-my-mind/feedback.jsonl

# Local dashboard port. It binds to 127.0.0.1 by default.
# MEMORY_GATEWAY_DASHBOARD_PORT=4317
